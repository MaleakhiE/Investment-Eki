# Database
DATABASE_TYPE="mysql"
DATABASE_NAME="personal_finance"
DATABASE_USERNAME="user"
DATABASE_PASSWORD="your-password"
DATABASE_PORT="3306"
DATABASE_HOST="localhost"

# Or use direct connection string (overrides individual vars above)
# DATABASE_URL="mysql://user:password@localhost:3306/personal_finance"

# Encryption
ENCRYPTION_KEY="your-32-byte-encryption-key-here"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Callback URL: http://localhost:3000/api/auth/callback/google
# Production callback: https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# SMTP Configuration
MAIL_HOST="smtp.example.com"
MAIL_PORT="465"
MAIL_USERNAME="your-email@example.com"
MAIL_PASSWORD="rotate-and-set-in-the-deployment-secret-store"
MAIL_ENCRYPTION="ssl"
MAIL_FROM_ADDRESS="noreply@example.com"
SMTP_ALLOWED_HOSTS="smtp.hostinger.com"
SUPERADMIN_EMAIL="owner@example.com"
SUPERADMIN_PASSWORD=""
