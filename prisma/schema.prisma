generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                        BigInt   @id @default(autoincrement())
  email                     String   @unique @db.VarChar(512)
  password_hash             String?  @db.VarChar(255)
  ai_recommendation_enabled Boolean  @default(true)
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
  role                      UserRole @default(USER)
  session_version           Int      @default(1)

  cashflows             MonthlyCashflow[]
  transactions          Transaction[]
  investments           Investment[]
  notifications         NotificationLog[]
  smtpSettings          SmtpSettings?
  notificationSettings  NotificationSettings?
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  financialGoals        FinancialGoal[]
  passwordResetTokens   PasswordResetToken[]
  financialAccounts     FinancialAccount[]
  oauthAccounts         OauthAccount[]

  @@map("users")
}

model OauthAccount {
  id                  BigInt   @id @default(autoincrement())
  user_id             BigInt
  provider            String   @db.VarChar(50)
  provider_account_id String   @db.VarChar(255)
  created_at          DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@unique([user_id, provider])
  @@map("oauth_accounts")
}

enum UserRole {
  USER
  SUPERADMIN
}

model ApplicationSmtpSettings {
  id         Int      @id
  host       String   @db.VarChar(255)
  port       Int
  secure     Boolean  @default(false)
  smtp_user  String   @db.VarChar(512)
  smtp_pass  String   @db.VarChar(512)
  from_email String   @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("application_smtp_settings")
}

model PasswordResetToken {
  id             BigInt    @id @default(autoincrement())
  user_id        BigInt
  token_hash     String    @unique @db.Char(64)
  active_user_id BigInt?   @unique
  expires_at     DateTime
  used_at        DateTime?
  created_at     DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@map("password_reset_tokens")
}

model MonthlyCashflow {
  id             BigInt   @id @default(autoincrement())
  user_id        BigInt
  month          String   @db.VarChar(7)
  income         String   @db.VarChar(255)
  expense_rent   String   @db.VarChar(255)
  expense_living String   @db.VarChar(255)
  expense_other  String   @db.VarChar(255)
  total_expense  String   @db.VarChar(255)
  net_cashflow   String   @db.VarChar(255)
  created_at     DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id, month])
  @@map("monthly_cashflow")
}

model Transaction {
  id                     BigInt          @id @default(autoincrement())
  user_id                BigInt
  date                   DateTime        @db.Date
  type                   TransactionType
  category               String          @db.VarChar(50)
  description            String          @db.VarChar(512)
  amount                 String          @db.VarChar(255)
  account                String?         @db.VarChar(100)
  account_id             BigInt?
  destination_account_id BigInt?
  receipt_image          String?         @db.LongText
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt

  user                User                 @relation(fields: [user_id], references: [id])
  sourceAccount       FinancialAccount?    @relation("TransactionSourceAccount", fields: [account_id], references: [id], onDelete: SetNull)
  destinationAccount  FinancialAccount?    @relation("TransactionDestinationAccount", fields: [destination_account_id], references: [id], onDelete: SetNull)
  recurringOccurrence RecurringOccurrence?

  @@index([user_id, date])
  @@index([account_id, type])
  @@index([destination_account_id, type])
  @@map("transactions")
}

model FinancialAccount {
  id              BigInt               @id @default(autoincrement())
  user_id         BigInt
  name            String               @db.VarChar(100)
  type            FinancialAccountType @default(BANK)
  opening_balance String?              @db.VarChar(255)
  color           String?              @db.VarChar(20)
  is_archived     Boolean              @default(false)
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt

  user                    User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sourceTransactions      Transaction[]          @relation("TransactionSourceAccount")
  destinationTransactions Transaction[]          @relation("TransactionDestinationAccount")
  recurringTransactions   RecurringTransaction[] @relation("RecurringSourceAccount")

  @@unique([user_id, name])
  @@unique([id, user_id])
  @@index([user_id, is_archived])
  @@map("financial_accounts")
}

model SmtpSettings {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt   @unique
  host       String   @db.VarChar(255)
  port       String   @db.VarChar(10)
  smtp_user  String   @db.VarChar(512)
  smtp_pass  String   @db.VarChar(512)
  from_email String   @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  owner User @relation(fields: [user_id], references: [id])

  @@map("smtp_settings")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum FinancialAccountType {
  BANK
  WALLET
  CASH
}

model Investment {
  id         BigInt         @id @default(autoincrement())
  user_id    BigInt
  type       InvestmentType
  created_at DateTime       @default(now())

  user      User                 @relation(fields: [user_id], references: [id])
  snapshots InvestmentSnapshot[]

  @@unique([user_id, type])
  @@map("investments")
}

model InvestmentSnapshot {
  id              BigInt   @id @default(autoincrement())
  investment_id   BigInt
  month           String   @db.VarChar(7)
  invested_amount String   @db.VarChar(255)
  current_value   String   @db.VarChar(255)
  platform        String?  @db.VarChar(100)
  product_name    String?  @db.VarChar(255)
  units           String?  @db.VarChar(50)
  nav_per_unit    String?  @db.VarChar(50)
  created_at      DateTime @default(now())

  investment Investment @relation(fields: [investment_id], references: [id])

  @@unique([investment_id, month])
  @@map("investment_snapshots")
}

model NotificationLog {
  id            BigInt                     @id @default(autoincrement())
  user_id       BigInt
  month         String                     @db.VarChar(7)
  type          NotificationType
  status        NotificationDeliveryStatus @default(PENDING)
  claimed_at    DateTime                   @default(now())
  attempt_count Int                        @default(1)
  sent_at       DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id, month, type])
  @@map("notification_logs")
}

model NotificationSettings {
  id                    BigInt   @id @default(autoincrement())
  user_id               BigInt   @unique
  monthly_reminder      Boolean  @default(true)
  monthly_reminder_day  Int      @default(25)
  monthly_summary       Boolean  @default(true)
  low_balance_alert     Boolean  @default(false)
  low_balance_threshold String   @default("0") @db.VarChar(255)
  custom_alerts         String?  @db.Text
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map("notification_settings")
}

enum InvestmentType {
  GOLD
  MUTUAL_FUND
}

enum NotificationType {
  REMINDER
  SUMMARY
  LOW_BALANCE
  CUSTOM
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

// Budget per kategori
model Budget {
  id         BigInt       @id @default(autoincrement())
  user_id    BigInt
  category   String       @db.VarChar(50)
  amount     String       @db.VarChar(255) // Encrypted
  period     BudgetPeriod @default(MONTHLY)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id, category])
  @@map("budgets")
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

// Recurring transactions (transaksi berulang)
model RecurringTransaction {
  id            BigInt             @id @default(autoincrement())
  user_id       BigInt
  type          TransactionType
  category      String             @db.VarChar(50)
  description   String             @db.VarChar(512)
  amount        String             @db.VarChar(255) // Encrypted
  frequency     RecurringFrequency
  day_of_month  Int? // For monthly: 1-28
  day_of_week   Int? // For weekly: 0-6 (Sunday-Saturday)
  month_of_year Int? // For yearly: 1-12
  account_id    BigInt?
  start_date    DateTime           @db.Date
  end_date      DateTime?          @db.Date
  is_active     Boolean            @default(true)
  last_run      DateTime?          @db.Date
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt

  user        User                  @relation(fields: [user_id], references: [id])
  account     FinancialAccount?     @relation("RecurringSourceAccount", fields: [account_id, user_id], references: [id, user_id], onDelete: Restrict)
  occurrences RecurringOccurrence[]

  @@index([account_id])
  @@map("recurring_transactions")
}

model RecurringOccurrence {
  id                       BigInt   @id @default(autoincrement())
  recurring_transaction_id BigInt
  scheduled_date           DateTime @db.Date
  transaction_id           BigInt?  @unique
  created_at               DateTime @default(now())

  recurringTransaction RecurringTransaction @relation(fields: [recurring_transaction_id], references: [id], onDelete: Cascade)
  transaction          Transaction?         @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@unique([recurring_transaction_id, scheduled_date], map: "recurring_occurrence_schedule_key")
  @@map("recurring_occurrences")
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// Financial Goals (target keuangan)
model FinancialGoal {
  id             BigInt       @id @default(autoincrement())
  user_id        BigInt
  name           String       @db.VarChar(100)
  target_amount  String       @db.VarChar(255) // Encrypted
  current_amount String       @db.VarChar(255) // Encrypted
  deadline       DateTime?    @db.Date
  category       GoalCategory
  priority       Int          @default(1) // 1=high, 2=medium, 3=low
  is_completed   Boolean      @default(false)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map("financial_goals")
}

enum GoalCategory {
  EMERGENCY_FUND
  INVESTMENT
  VACATION
  GADGET
  VEHICLE
  PROPERTY
  EDUCATION
  WEDDING
  OTHER
}
